# PostgreSQL (docker compose)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432

# API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080

# Production web (docker compose --profile full)
WEB_PORT=8080

# Frontend (Vite dev) — leave empty to use /api proxy
# VITE_API_URL=http://localhost:8000

# Backend local dev (copy to backend/.env)
# DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
